#!/usr/bin/env bash
# The non-QML half of File Shelf. Nautilus is a separate Wayland client, so
# Hyprland is the only component that can move, resize, focus, and park it.

set -u -o pipefail
umask 077

ACTION="${1:-toggle}"
EDGE="${2:-right}"
MONITOR="${3:-}"
SIZE="${4:-44}"
SPECIAL_WORKSPACE="special:file-shelf"
SCRATCHPAD_WORKSPACE="special:scratchpad"
STATE_HOME="${XDG_STATE_HOME:-${HOME:-}/.local/state}"
STATE_DIR="$STATE_HOME/omarchy"
STATE_FILE="$STATE_DIR/file-shelf.window"
INSTANCE="${HYPRLAND_INSTANCE_SIGNATURE:-}"
WINDOW_TAG="kigojomo-file-shelf"
LOCK_FILE="$STATE_DIR/file-shelf.lock"

die() {
  printf 'file-shelf: %s\n' "$1" >&2
  exit 1
}

case "$ACTION" in
  show|hide|toggle|status|focused) ;;
  *) die "usage: file-shelf-nautilus {show|hide|toggle|status|focused} [left|right|bottom] [monitor]" ;;
esac

case "$EDGE" in
  left|right|bottom) ;;
  *) die "edge must be left, right, or bottom" ;;
esac

[[ "$SIZE" =~ ^[0-9]+$ ]] || die "size must be a percentage from 25 to 75"
((SIZE >= 25 && SIZE <= 75)) || die "size must be a percentage from 25 to 75"

if ! command -v hyprctl >/dev/null 2>&1; then
  die "hyprctl is required"
fi

if ! command -v jq >/dev/null 2>&1; then
  die "jq is required"
fi

if ! command -v flock >/dev/null 2>&1; then
  die "flock is required"
fi

mkdir -p -- "$STATE_DIR" || die "could not create $STATE_DIR"
exec 9>"$LOCK_FILE" || die "could not open the control lock"
flock -w 10 9 || die "could not acquire the control lock"

is_valid_address() {
  [[ "$1" =~ ^0x[0-9a-fA-F]+$ ]]
}

clients_json() {
  hyprctl clients -j 2>/dev/null
}

address_from_state() {
  local identity address pid instance
  [[ -r "$STATE_FILE" ]] || return 0
  # Addresses and PIDs can both be reused. The tag belongs to the live window,
  # so a replacement surface cannot inherit ownership from this state file.
  identity=$(jq -er '[.address, (.pid | tostring), .instance] | @tsv' "$STATE_FILE" 2>/dev/null) || return 0
  IFS=$'\t' read -r address pid instance <<< "$identity"
  is_valid_address "$address" || return 0
  [[ "$pid" =~ ^[1-9][0-9]*$ && -n "$INSTANCE" && "$instance" == "$INSTANCE" ]] || return 0
  clients_json | jq -r --arg address "$address" --argjson pid "$pid" --arg tag "$WINDOW_TAG" '
    .[] | select(.address == $address and .pid == $pid)
    | select((.tags // []) | index($tag))
    | select((.class // "" | ascii_downcase) == "org.gnome.nautilus") | .address
  ' | head -n1
}

tag_owned_window() {
  local address="$1" title="$2" pid="$3"
  is_valid_address "$address" || return 1
  [[ "$title" =~ ^file-shelf-launch\.[a-zA-Z0-9]+$ && "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  # Check and tag in one compositor operation. An address recycled after our
  # snapshot must not transfer ownership to a replacement window.
  hyprctl eval "local w = hl.get_window(\"address:$address\"); if not w or w.pid ~= $pid or w.title ~= \"$title\" or string.lower(w.class) ~= \"org.gnome.nautilus\" then error(\"File Shelf launch window changed\") end; hl.dispatch(hl.dsp.window.tag({ window = \"address:$address\", tag = \"+$WINDOW_TAG\" }))" >/dev/null 2>&1 || return 1
  clients_json | jq -e --arg address "$address" --arg tag "$WINDOW_TAG" '
    .[] | select(.address == $address) | (.tags // []) | index($tag) != null
  ' >/dev/null
}

remember_address() {
  local address="$1" launch="${2:-null}" temporary pid
  is_valid_address "$address" || return 1
  [[ -n "$INSTANCE" ]] || return 1
  pid=$(clients_json | jq -er --arg address "$address" '.[] | select(.address == $address) | .pid') || return 1
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  temporary=$(mktemp "$STATE_DIR/file-shelf.window.XXXXXX") || return 1
  if ! jq -n --arg address "$address" --argjson pid "$pid" --arg instance "$INSTANCE" --argjson launch "$launch" \
    '{address: $address, pid: $pid, instance: $instance} + (if $launch == null then {} else {launch: $launch} end)' > "$temporary" || ! mv -f -- "$temporary" "$STATE_FILE"; then
    rm -f -- "$temporary"
    return 1
  fi
}

dispatch_focus() {
  local address="$1"
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1
}

dispatch_move_workspace() {
  local address="$1"
  local workspace="$2"
  if [[ "$workspace" == special:* ]]; then
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$workspace\", follow = false })" >/dev/null 2>&1 ||
      hyprctl dispatch movetoworkspacesilent "$workspace,address:$address" >/dev/null 2>&1
  else
    local current_workspace="$workspace"
    if [[ "$workspace" == "current" ]]; then
      current_workspace=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty')
    fi
    [[ "$current_workspace" =~ ^-?[0-9]+$ ]] || return 1
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$current_workspace\", follow = false })" >/dev/null 2>&1 ||
      hyprctl dispatch movetoworkspacesilent "$current_workspace,address:$address" >/dev/null 2>&1
  fi
}

ensure_floating() {
  local address="$1"
  local floating
  floating=$(clients_json | jq -r --arg address "$address" '.[] | select(.address == $address) | .floating // false' | head -n1)
  [[ "$floating" == "true" ]] && return 0

  hyprctl dispatch "hl.dsp.window.float({ window = \"address:$address\", action = \"on\" })" >/dev/null 2>&1 ||
    hyprctl dispatch togglefloating "address:$address" >/dev/null 2>&1

  floating=$(clients_json | jq -r --arg address "$address" '.[] | select(.address == $address) | .floating // false' | head -n1)
  if [[ "$floating" != "true" ]]; then
    hyprctl dispatch togglefloating "address:$address" >/dev/null 2>&1 || return 1
    floating=$(clients_json | jq -r --arg address "$address" '.[] | select(.address == $address) | .floating // false' | head -n1)
  fi
  [[ "$floating" == "true" ]]
}

monitor_geometry() {
  hyprctl monitors -j 2>/dev/null | jq -r --arg monitor "$MONITOR" '
    ([.[] | select(.disabled == false and .name == $monitor)]
      + [.[] | select(.disabled == false and .focused == true)]
      + [.[] | select(.disabled == false)])
    | .[0]
    | if . == null then empty else [(.x // 0), (.y // 0), (.width // 0), (.height // 0), (.scale // 1), (.transform // 0), ((.reserved // [0,0,0,0])[0]), ((.reserved // [0,0,0,0])[1]), ((.reserved // [0,0,0,0])[2]), ((.reserved // [0,0,0,0])[3])] | @tsv end
  '
}

apply_geometry() {
  local address="$1"
  local geometry
  geometry=$(monitor_geometry)
  [[ -n "$geometry" ]] || return 1

  local mx my raw_width raw_height scale transform reserved_left reserved_top reserved_right reserved_bottom
  IFS=$'\t' read -r mx my raw_width raw_height scale transform reserved_left reserved_top reserved_right reserved_bottom <<< "$geometry"

  # Hyprland reports the panel's physical dimensions while transformed
  # outputs use swapped logical dimensions for quarter turns.
  if (( transform % 2 == 1 )); then
    local rotated_width="$raw_width"
    raw_width="$raw_height"
    raw_height="$rotated_width"
  fi

  local monitor_width monitor_height usable_x usable_y usable_width usable_height
  monitor_width=$(awk -v value="$raw_width" -v divisor="$scale" 'BEGIN { printf "%d", value / divisor }')
  monitor_height=$(awk -v value="$raw_height" -v divisor="$scale" 'BEGIN { printf "%d", value / divisor }')
  usable_x=$((mx + reserved_left + 16))
  usable_y=$((my + reserved_top + 16))
  usable_width=$((monitor_width - reserved_left - reserved_right - 32))
  usable_height=$((monitor_height - reserved_top - reserved_bottom - 32))
  ((usable_width > 200 && usable_height > 200)) || return 1

  local x y width height
  if [[ "$EDGE" == "left" || "$EDGE" == "right" ]]; then
    width=$((usable_width * SIZE / 100))
    ((width < 320)) && width=320
    ((width > usable_width)) && width=$usable_width
    height=$usable_height
    y=$usable_y
    if [[ "$EDGE" == "right" ]]; then
      x=$((usable_x + usable_width - width))
    else
      x=$usable_x
    fi
  else
    height=$((usable_height * SIZE / 100))
    ((height < 240)) && height=240
    ((height > usable_height)) && height=$usable_height
    width=$usable_width
    x=$usable_x
    if [[ "$EDGE" == "bottom" ]]; then
      y=$((usable_y + usable_height - height))
    else
      y=$usable_y
    fi
  fi

  hyprctl dispatch resizewindowpixel "exact $width $height,address:$address" >/dev/null 2>&1 ||
    hyprctl dispatch "hl.dsp.window.resize({ window = \"address:$address\", x = $width, y = $height })" >/dev/null 2>&1 ||
    return 1
  hyprctl dispatch movewindowpixel "exact $x $y,address:$address" >/dev/null 2>&1 ||
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", x = $x, y = $y })" >/dev/null 2>&1 ||
    return 1
}

monitor_workspace() {
  local special_workspace
  special_workspace=$(hyprctl monitors -j 2>/dev/null | jq -r --arg monitor "$MONITOR" --arg workspace "$SCRATCHPAD_WORKSPACE" '
    ([.[] | select(.disabled == false and .name == $monitor)]
      + [.[] | select(.disabled == false and .focused == true)]
      + [.[] | select(.disabled == false)])
    | .[0].specialWorkspace.name // empty
    | select(. == $workspace)
  ')
  if [[ "$special_workspace" == "$SCRATCHPAD_WORKSPACE" ]]; then
    printf '%s\n' "$SCRATCHPAD_WORKSPACE"
    return 0
  fi

  hyprctl monitors -j 2>/dev/null | jq -r --arg monitor "$MONITOR" '
    ([.[] | select(.disabled == false and .name == $monitor)]
      + [.[] | select(.disabled == false and .focused == true)]
      + [.[] | select(.disabled == false)])
    | .[0].activeWorkspace.id // empty
  '
}

# Address requests to Nautilus's unique bus owner, not a well-known name that
# could switch to a replacement process midway through initialization.
nautilus_bus() {
  busctl --user --timeout=5 --auto-start=no --json=short "$@"
}

window_locations() {
  nautilus_bus get-property "$1" /org/freedesktop/FileManager1 \
    org.freedesktop.FileManager1 OpenWindowsWithLocations
}

window_action() {
  nautilus_bus call "$1" "$2" org.gtk.Actions Activate sava{sv} "$3" 0 0 >/dev/null
}

wait_home_tabs() {
  local owner="$1" path="$2" count="$3" home_uri="$4" locations attempt
  for attempt in {1..30}; do
    locations=$(window_locations "$owner") || return 1
    if jq -e --arg path "$path" --arg uri "$home_uri" --argjson count "$count" '
      .data[$path] == [range($count) | $uri]
    ' <<< "$locations" >/dev/null; then return 0; fi
    sleep 0.1
  done
  return 1
}

finish_launch() {
  local address="$1" launch owner path directory uri home_uri locations count
  launch=$(jq -c '.launch // empty' "$STATE_FILE") || return 1
  [[ -n "$launch" ]] || return 0
  owner=$(jq -r '.owner' <<< "$launch")
  path=$(jq -r '.path' <<< "$launch")
  directory=$(jq -r '.directory' <<< "$launch")
  uri=$(jq -r '.uri' <<< "$launch")
  home_uri=$(jq -r '.homeUri' <<< "$launch")
  [[ "$owner" =~ ^:[0-9]+\.[0-9]+$ && "$path" =~ ^/org/gnome/Nautilus/window/[0-9]+$ ]] || return 1

  locations=$(window_locations "$owner") || return 1
  if jq -e --arg path "$path" --arg uri "$uri" '.data[$path] == [$uri]' <<< "$locations" >/dev/null; then
    window_action "$owner" "$path" go-home || return 1
    wait_home_tabs "$owner" "$path" 1 "$home_uri" || return 1
    locations=$(window_locations "$owner") || return 1
  fi

  # A fresh Home tab has no bootstrap directory in its Back history. Only
  # replace our known Home-only tabs while the new window is parked. If its
  # contents changed unexpectedly, leave them alone and report the interruption.
  count=$(jq -er --arg path "$path" --arg uri "$home_uri" '
    .data[$path] | select(. == [$uri] or . == [$uri, $uri]) | length
  ' <<< "$locations") || return 1
  if [[ "$count" == 1 ]]; then
    window_action "$owner" "$path" new-tab || return 1
    wait_home_tabs "$owner" "$path" 2 "$home_uri" || return 1
  fi
  window_action "$owner" "$path" close-other-tabs || return 1
  wait_home_tabs "$owner" "$path" 1 "$home_uri" || return 1
  [[ "$(address_from_state)" == "$address" ]] || return 1
  remember_address "$address" || return 1
  # Never delete recursively: preserve anything a user put in this directory.
  rmdir -- "$directory" 2>/dev/null || true
}

launch_and_find() {
  local owner="" pid directory uri title home_uri locations paths candidates address path attempt actions launch pending temporary
  command -v busctl >/dev/null 2>&1 || die "busctl is required"
  # Resume an uncertain request instead of launching twice if its D-Bus reply
  # was lost. Once a tagged window exists, find_address resumes finish_launch.
  pending=$(jq -cer --arg instance "$INSTANCE" 'select(.instance == $instance) | .launch | select(.path == null)' "$STATE_FILE" 2>/dev/null) || pending=""
  if [[ -n "$pending" ]]; then
    owner=$(jq -r '.owner' <<< "$pending")
    pid=$(jq -r '.pid' <<< "$pending")
    directory=$(jq -r '.directory' <<< "$pending")
    uri=$(jq -r '.uri' <<< "$pending")
    home_uri=$(jq -r '.homeUri' <<< "$pending")
    title=${directory##*/}
    if [[ ! "$owner" =~ ^:[0-9]+\.[0-9]+$ || ! "$pid" =~ ^[1-9][0-9]*$ || ! "$title" =~ ^file-shelf-launch\.[a-zA-Z0-9]+$ || ! -d "$directory" ]]; then
      owner=""
    elif ! nautilus_bus call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus GetConnectionUnixProcessID s "$owner" | jq -e --argjson pid "$pid" '.data[0] == $pid' >/dev/null; then
      owner=""
    fi
  fi
  if [[ -z "$owner" ]]; then
    # Activate the normal Nautilus service. No separate bus or launcher child.
    busctl --user --timeout=8 call org.freedesktop.DBus /org/freedesktop/DBus \
      org.freedesktop.DBus StartServiceByName su org.gnome.Nautilus 0 >/dev/null || return 1
    owner=$(nautilus_bus call org.freedesktop.DBus /org/freedesktop/DBus \
      org.freedesktop.DBus GetNameOwner s org.gnome.Nautilus | jq -er '.data[0]') || return 1
    [[ "$owner" =~ ^:[0-9]+\.[0-9]+$ ]] || return 1
    pid=$(nautilus_bus call org.freedesktop.DBus /org/freedesktop/DBus \
      org.freedesktop.DBus GetConnectionUnixProcessID s "$owner" | jq -er '.data[0]') || return 1
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    window_locations "$owner" >/dev/null || return 1
    directory=$(mktemp -d -- "$STATE_DIR/file-shelf-launch.XXXXXXXXXXXX") || return 1
    directory=$(realpath -e -- "$directory") || return 1
    title=${directory##*/}
    uri=$(jq -rn --arg path "$directory" '"file://" + ($path | split("/") | map(@uri) | join("/"))')
    home_uri=$(jq -rn --arg path "$HOME" '"file://" + ($path | split("/") | map(@uri) | join("/"))')
    temporary=$(mktemp "$STATE_DIR/file-shelf.window.XXXXXX") || return 1
    if ! jq -n --arg owner "$owner" --argjson pid "$pid" --arg directory "$directory" --arg uri "$uri" \
      --arg homeUri "$home_uri" --arg instance "$INSTANCE" \
      '{instance:$instance,launch:{owner:$owner,pid:$pid,directory:$directory,uri:$uri,homeUri:$homeUri}}' > "$temporary" || ! mv -f -- "$temporary" "$STATE_FILE"; then
      rm -f -- "$temporary"
      return 1
    fi
    nautilus_bus call "$owner" /org/gnome/Nautilus org.gtk.Application Open \
      assa{sv} 1 "$uri" new-window 0 >/dev/null || return 1
  fi

  for attempt in {1..60}; do
    locations=$(window_locations "$owner") || return 1
    paths=$(jq -c --arg uri "$uri" '[.data | to_entries[] | select(.value == [$uri]) | .key]' <<< "$locations") || return 1
    candidates=$(clients_json | jq -c --arg title "$title" --argjson pid "$pid" '
      [.[] | select(.pid == $pid and .title == $title)
       | select((.class // "" | ascii_downcase) == "org.gnome.nautilus") | .address]
    ') || return 1
    # This token belongs only to our request. Other new Nautilus windows are
    # irrelevant, even when they map first or share its PID and initial title.
    if [[ "$(jq length <<< "$paths")" -gt 1 || "$(jq length <<< "$candidates")" -gt 1 ]]; then
      die "Nautilus returned duplicate launch identities"
    fi
    if [[ "$(jq length <<< "$paths")" == 1 && "$(jq length <<< "$candidates")" == 1 ]]; then
      address=$(jq -r '.[0]' <<< "$candidates")
      path=$(jq -r '.[0]' <<< "$paths")
      is_valid_address "$address" || return 1
      [[ "$path" =~ ^/org/gnome/Nautilus/window/[0-9]+$ ]] || return 1
      actions=$(nautilus_bus call "$owner" "$path" org.gtk.Actions List) || return 1
      jq -e '.data[0] | (index("go-home") != null) and (index("new-tab") != null) and (index("close-other-tabs") != null)' <<< "$actions" >/dev/null || die "Nautilus window actions are unavailable"
      tag_owned_window "$address" "$title" "$pid" || return 1
      launch=$(jq -cn --arg owner "$owner" --arg path "$path" --arg directory "$directory" \
        --arg uri "$uri" --arg homeUri "$home_uri" '{owner:$owner,path:$path,directory:$directory,uri:$uri,homeUri:$homeUri}')
      remember_address "$address" "$launch" || return 1
      dispatch_move_workspace "$address" "$SPECIAL_WORKSPACE" || return 1
      finish_launch "$address" || die "could not finish Nautilus setup; retry opening File Shelf"
      printf '%s\n' "$address"
      return 0
    fi
    sleep 0.1
  done
  die "timed out waiting for the requested Nautilus window"
}

find_address() {
  local address
  address=$(address_from_state) || die "could not query Nautilus windows"
  if is_valid_address "$address"; then
    if jq -e '.launch != null' "$STATE_FILE" >/dev/null; then
      dispatch_move_workspace "$address" "$SPECIAL_WORKSPACE" || return 1
    fi
    finish_launch "$address" || die "could not finish Nautilus setup; retry opening File Shelf"
    printf '%s\n' "$address"
    return 0
  fi
  launch_and_find
}

fail_show() {
  local address="$1"
  shift
  dispatch_move_workspace "$address" "$SPECIAL_WORKSPACE" >/dev/null 2>&1 || true
  die "$*"
}

show_window() {
  local address
  [[ -n "$INSTANCE" ]] || die "run inside a Hyprland session"
  command -v awk >/dev/null 2>&1 || die "awk is required"
  address=$(find_address) || die "Nautilus did not open a window"
  is_valid_address "$address" || die "Nautilus returned an invalid window address"
  remember_address "$address" || fail_show "$address" "could not remember the Nautilus window"
  local target_workspace
  target_workspace=$(monitor_workspace)
  [[ "$target_workspace" =~ ^-?[0-9]+$ || "$target_workspace" == special:* ]] || fail_show "$address" "could not determine the target monitor workspace"
  dispatch_move_workspace "$address" "$target_workspace" || fail_show "$address" "could not move Nautilus to the target monitor"
  ensure_floating "$address" || fail_show "$address" "could not float the Nautilus window"
  apply_geometry "$address" || fail_show "$address" "could not position the Nautilus window"
  dispatch_focus "$address" || fail_show "$address" "could not focus the Nautilus window"
  printf 'open\n'
}

hide_window() {
  local address
  address=$(address_from_state) || die "could not query Nautilus windows"
  is_valid_address "$address" || { printf 'closed\n'; return 0; }
  dispatch_move_workspace "$address" "$SPECIAL_WORKSPACE" || die "could not hide the Nautilus window"
  printf 'hidden\n'
}

status_window() {
  local address workspace
  address=$(address_from_state) || die "could not query Nautilus windows"
  if ! is_valid_address "$address"; then
    printf 'closed\n'
    return 0
  fi
  workspace=$(clients_json | jq -r --arg address "$address" '.[] | select(.address == $address) | .workspace.name // empty' | head -n1) || die "could not query Nautilus workspace"
  [[ -n "$workspace" ]] || { printf 'closed\n'; return 0; }
  [[ "$workspace" == "$SPECIAL_WORKSPACE" ]] && printf 'hidden\n' || printf 'open\n'
}

focused_window() {
  local address active active_address managed_pid
  address=$(address_from_state) || die "could not query Nautilus windows"
  if ! is_valid_address "$address"; then
    printf 'closed\n'
    return 0
  fi
  active=$(hyprctl activewindow -j 2>/dev/null) || return 1
  active_address=$(jq -r '.address // empty' <<< "$active") || return 1
  # Native Nautilus dialogs have their own surface. Keep the shelf available
  # while the same Nautilus process has focus, including its other windows.
  managed_pid=$(jq -er '.pid' "$STATE_FILE") || return 1
  if [[ "$active_address" == "$address" ]] || jq -e --argjson pid "$managed_pid" '.pid == $pid' <<< "$active" >/dev/null; then
    printf 'focused\n'
  else
    printf 'unfocused\n'
  fi
}

case "$ACTION" in
  show) show_window ;;
  hide) hide_window ;;
  status) status_window ;;
  focused) focused_window ;;
  toggle)
    if [[ "$(status_window)" == "open" ]]; then hide_window; else show_window; fi
    ;;
esac
